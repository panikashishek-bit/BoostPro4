# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
# Сам .env в git не попадает (см. .gitignore) — секреты не коммитим.

# Порт, на котором PostgreSQL слушает на ХОСТЕ (пробрасывает docker-compose).
# Если 5432 занят другим проектом — поменяйте здесь И в DATABASE_URL.
DB_PORT=

# Строка подключения к PostgreSQL для Prisma.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:ПОРТ/БАЗА?schema=public
# Пользователь/пароль/база берутся из docker-compose.yml, порт — из DB_PORT выше.
DATABASE_URL=

# Пароль для входа в /admin.
ADMIN_PASSWORD=
