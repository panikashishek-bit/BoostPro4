# Настройки пульта. Только ИМЕНА переменных и безопасные значения по умолчанию.
# Этот файл коммитится. Рабочие значения — в .env рядом (он в .gitignore).
#
# Пульт читает ТОЛЬКО .env рядом с этим файлом. В .env приложения, бота и
# менеджера он не заглядывает: папку dashboard/ можно унести целиком в другой
# проект, и она останется рабочей.

# Пароль на вход в пульт. По умолчанию — admin.
# Пока пароль равен admin, пульт сам пишет об этом на странице.
DASHBOARD_PASSWORD=admin

# --- Источники данных. Пусто = «не подключено», пульт скажет об этом человеческим языком. ---

# Лог событий бота (SQLite). То же значение стоит в bot_administrator/.env:
# бот пишет в этот файл, пульт его читает.
EVENTS_DB_PATH=data/events.db

# Таблица клиентов: id Google-таблицы (длинная строка из её адреса).
CLIENTS_SHEET_ID=

# Папка с готовыми расшифровками. Относительный путь считается от корня проекта.
TRANSCRIPTS_DIR=

# Через сколько минут молчания обращение считается законченным.
# ⚠️ Та же переменная есть у бота (bot_administrator/.env), значения ОБЯЗАНЫ совпадать:
# по ней бот режет сессии, а пульт считает брошенные. Пульт сверяет своё значение
# с тем, что бот записал в базу, и скажет в «проверке связи», если они разошлись.
SESSION_TIMEOUT_MIN=30

# Ключ служебного аккаунта для таблицы клиентов — файлом или строкой.
# Локально удобнее файлом; путь считается от корня проекта.
# В контейнере файла нет — туда кладут тот же JSON одной строкой в CLIENTS_SA_KEY.
# Права нужны только на чтение: пульт показывает, а не правит.
CLIENTS_SA_KEY_PATH=
CLIENTS_SA_KEY=
