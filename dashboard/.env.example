# Настройки пульта. Только ИМЕНА переменных и безопасные значения по умолчанию.
# Этот файл коммитится. Рабочие значения — в .env рядом (он в .gitignore).
#
# Пульт читает ТОЛЬКО .env рядом с этим файлом. В .env приложения, бота и
# менеджера он не заглядывает: папку dashboard/ можно унести целиком в другой
# проект, и она останется рабочей.

# Пароль на вход в пульт. По умолчанию — admin.
# Пока пароль равен admin, пульт сам пишет об этом на странице.
DASHBOARD_PASSWORD=admin

# --- Источники данных. Пусто = «не подключено», пульт скажет об этом человеческим языком. ---

# Лог событий приложения: путь к файлу журнала или базы.
EVENTS_DB_PATH=

# Таблица клиентов: id Google-таблицы (длинная строка из её адреса).
CLIENTS_SHEET_ID=

# Папка с готовыми расшифровками. Относительный путь считается от корня проекта.
TRANSCRIPTS_DIR=
