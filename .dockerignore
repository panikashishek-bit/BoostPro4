node_modules
.next
.git
.env
.env.*
!.env.example
# Настройки пульта в образ не попадают: он получает их томом во время работы.
# Правила выше срабатывают только в корне, вложенный файл нужно назвать отдельно.
dashboard/.env
dashboard/.env.*
!dashboard/.env.example
bot_administrator/node_modules
bot_administrator/data
bot_administrator/.env
bot_administrator/.env.*
!bot_administrator/.env.example
# Лог событий бота: на сервере он лежит рядом с кодом и попал бы в контекст сборки,
# то есть в слои образа. База — это данные; в образе им не место, а копия в слое
# ещё и устаревает. Внутрь контейнеров она приходит томом.
data

docs
journal
*.log
