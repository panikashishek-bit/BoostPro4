# Шаблон секретов бота-администратора: только ИМЕНА переменных, без значений.
# Этот файл коммитится. Реальные значения — в .env рядом (он в .gitignore).

# Токен Telegram-бота, выдаёт @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ OpenRouter, выдаётся на курсе
OPENROUTER_API_KEY=

# Доступ к API приложения (ключ тот же, что в project/.env; адрес меняется при переезде на сервер)
APP_API_KEY=
APP_API_URL=

# Ключ AssemblyAI, выдаётся на курсе
ASSEMBLYAI_API_KEY=

# Google Sheets: журнал обращений.
# Путь к ключу служебного аккаунта (от папки bot_administrator) и ID таблицы «Клиенты».
GOOGLE_SA_KEY_PATH=
SHEET_ID=
