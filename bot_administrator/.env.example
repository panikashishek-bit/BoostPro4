# Шаблон секретов бота-администратора: только ИМЕНА переменных, без значений.
# Этот файл коммитится. Реальные значения — в .env рядом (он в .gitignore).

# Токен Telegram-бота, выдаёт @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ OpenRouter, выдаётся на курсе
OPENROUTER_API_KEY=

# Доступ к API приложения (ключ тот же, что в project/.env; адрес меняется при переезде на сервер)
APP_API_KEY=
APP_API_URL=

# Ключ AssemblyAI, выдаётся на курсе
ASSEMBLYAI_API_KEY=

# Google Sheets: журнал обращений.
# Путь к ключу служебного аккаунта (от папки bot_administrator) и ID таблицы «Клиенты».
GOOGLE_SA_KEY_PATH=
SHEET_ID=

# Лог событий бота (SQLite). Путь считается от КОРНЯ ПРОЕКТА, поэтому здесь и в
# dashboard/.env стоит одно и то же значение. Файл в git не едет и деплоем не возится.
EVENTS_DB_PATH=data/events.db

# Через сколько минут молчания обращение считается законченным.
# ⚠️ Та же переменная есть у пульта, и значения ОБЯЗАНЫ совпадать: по ней бот режет
# сессии, а пульт считает брошенные. Разъедутся — воронка соврёт правдоподобно.
# Бот пишет своё фактическое значение в базу, пульт сверяется и скажет о расхождении.
SESSION_TIMEOUT_MIN=30
